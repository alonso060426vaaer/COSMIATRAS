<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#b8577f">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Productividad">
<title>Control de Productividad</title>
<link rel="stylesheet" href="css/estilos.css">
</head>
<body>
<div class="wrap">

  <header>
    <button class="volver oculto" id="btnVolver">&larr; Volver</button>
    <h1 id="titulo">Cosmiatras</h1>
    <div class="spacer"></div>
    <button class="btn btn-linea btn-sm" id="btnReporte">Reporte</button>
  </header>

  <div id="aviso" class="aviso oculto"></div>

  <!-- PANTALLA 1 : lista de cosmiatras -->
  <section id="p1">
    <div id="listaCosm" class="grid-cosm">
      <!-- las tarjetas se insertan antes de este boton -->
      <button class="tile tile-agregar" id="btnAgregar">
        <span class="tile-mas">+</span>
        <span>Agregar cosmiatra</span>
      </button>
    </div>
  </section>

  <!-- PANTALLA 2 : hoja del dia -->
  <section id="p2" class="oculto">
    <div class="card">
      <div class="fila-paciente">
        <div>
          <label>Paciente</label>
          <input id="inPaciente" placeholder="Nombre" autocomplete="off">
        </div>
        <button class="btn btn-linea btn-sm oculto" id="btnNueva">Nueva paciente</button>
      </div>

      <div id="listaProcs"></div>

      <button class="btn btn-linea btn-sm" id="btnMasProc">+ Agregar procedimiento</button>
    </div>

    <!-- atenciones que quedaron abiertas en dias anteriores -->
    <div class="card card-pendientes oculto" id="cardPend">
      <div class="card-titulo">
        <b>Quedaron sin cerrar</b>
        <span class="fecha">De d&iacute;as anteriores</span>
      </div>
      <table>
        <thead><tr><th>Fecha</th><th>Paciente</th><th>Procedimiento</th><th>Inicio</th><th></th></tr></thead>
        <tbody id="tbPend"></tbody>
      </table>
    </div>

    <div class="card">
      <div class="card-titulo">
        <b>Hoy</b><span class="fecha" id="fechaHoy"></span>
      </div>
      <table>
        <thead><tr><th>Paciente</th><th>Procedimiento</th><th>Inicio</th><th>T&eacute;rmino</th><th></th></tr></thead>
        <tbody id="tbHoy"></tbody>
      </table>
      <div class="vacio oculto" id="vacioHoy">Sin atenciones todav&iacute;a</div>
    </div>
  </section>

  <!-- PANTALLA 3 : reporte -->
  <section id="p3" class="oculto">
    <div class="card">
      <div class="fila-form">
        <div>
          <label>Fecha</label>
          <input type="date" id="fFecha">
        </div>
        <div>
          <label>Cosmiatra</label>
          <select id="fCosm"></select>
        </div>
        <button class="btn btn-linea" id="btnExcel">Exportar Excel</button>
      </div>
    </div>

    <div class="card">
      <div class="totales">
        <div><b id="tPac">0</b><span>Pacientes</span></div>
        <div><b id="tAt">0</b><span>Procedimientos</span></div>
        <div><b id="tMin">0</b><span>Minutos</span></div>
      </div>
      <table>
        <thead><tr><th>Fecha</th><th>Cosmiatra</th><th>Paciente</th><th>Procedimiento</th><th>Inicio</th><th>T&eacute;rmino</th><th>Min</th></tr></thead>
        <tbody id="tbRep"></tbody>
      </table>
      <div class="vacio oculto" id="vacioRep">Sin registros</div>
    </div>
  </section>

</div>

<script>
/* ============================================================
   Cada registro = UN procedimiento con su propio cronometro.
   Una paciente puede tener varios registros el mismo dia.
   ============================================================ */

/* ---------- datos ---------- */
var DB = {
  cosmiatras: JSON.parse(localStorage.getItem('cosmiatras') || '["Denisse","Pamela","Karen"]'),
  registros:  JSON.parse(localStorage.getItem('registros')  || '[]')
};

function guardar(){
  localStorage.setItem('cosmiatras', JSON.stringify(DB.cosmiatras));
  localStorage.setItem('registros',  JSON.stringify(DB.registros));
}

/* Identificador propio de cada registro. Se usa en vez de la posicion
   dentro del arreglo, que cambia al borrar. */
var contadorId = 0;
function nuevoId(){
  return Date.now().toString(36) + '-' + (contadorId++);
}
function porId(id){
  for(var i = 0; i < DB.registros.length; i++){
    if(DB.registros[i].id === id) return DB.registros[i];
  }
  return null;
}

/* Version anterior: un registro traia proc1/proc2/proc3 juntos.
   Ahora cada procedimiento vive en su propio registro. */
function migrar(){
  var salida = [], cambio = false;
  DB.registros.forEach(function(r){
    if(r.proc1 === undefined && r.proc2 === undefined && r.proc3 === undefined){
      salida.push(r);
      return;
    }
    cambio = true;
    [r.proc1, r.proc2, r.proc3].forEach(function(p, k){
      if(!p && k > 0) return;
      salida.push({
        cosmiatra: r.cosmiatra, fecha: r.fecha, paciente: r.paciente,
        procedimiento: p || '', inicio: r.inicio, fin: r.fin
      });
    });
  });
  salida.forEach(function(r){
    if(!r.id){ r.id = nuevoId(); cambio = true; }
  });
  if(cambio){ DB.registros = salida; guardar(); }
}
migrar();

/* ---------- utilidades ---------- */
function $(id){ return document.getElementById(id); }

function hoy(){
  var d = new Date();
  return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
}
function ahora(){
  var d = new Date();
  return String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0');
}
function minutos(a,b){
  if(!a || !b) return '';
  var x = a.split(':'), y = b.split(':');
  return (y[0]*60 + +y[1]) - (x[0]*60 + +x[1]);
}
function fechaLarga(f){
  var p = f.split('-');
  return p[2] + '/' + p[1] + '/' + p[0];
}
function limpio(t){
  return String(t == null ? '' : t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

var cosmActual = null;

function aviso(txt){
  var a = $('aviso');
  a.textContent = txt;
  a.classList.remove('oculto');
  clearTimeout(aviso.t);
  aviso.t = setTimeout(function(){ a.classList.add('oculto'); }, 3000);
}

function pantalla(n){
  $('aviso').classList.add('oculto');
  ['p1','p2','p3'].forEach(function(p,i){ $(p).classList.toggle('oculto', i !== n-1); });
  $('btnVolver').classList.toggle('oculto', n === 1);
  $('btnReporte').classList.toggle('oculto', n === 3);
  $('titulo').textContent = n === 1 ? 'Cosmiatras' : (n === 2 ? cosmActual : 'Reporte');
}

/* ---------- pantalla 1 : lista de cosmiatras ---------- */

/* Iniciales para el circulo de la tarjeta */
function iniciales(nombre){
  var p = nombre.trim().split(/\s+/);
  return (p[0].charAt(0) + (p[1] ? p[1].charAt(0) : '')).toUpperCase();
}

/* Color estable por nombre, para reconocerlas de un vistazo */
var TONOS = ['#b8577f','#8d6ea8','#c07a52','#4f9d8b','#a8556b','#6f83b5','#b0824a','#5f9ab8'];
function tono(nombre){
  var s = 0;
  for(var i = 0; i < nombre.length; i++) s += nombre.charCodeAt(i);
  return TONOS[s % TONOS.length];
}

function pintarCosmiatras(){
  var cont = $('listaCosm'), mas = $('btnAgregar');

  /* se borran solo las tarjetas: el boton de agregar es fijo */
  Array.prototype.slice.call(cont.querySelectorAll('.cosm')).forEach(function(n){
    cont.removeChild(n);
  });

  DB.cosmiatras.forEach(function(nombre){
    var enCurso = DB.registros.filter(function(r){ return r.cosmiatra === nombre && !r.fin; }).length;

    var div = document.createElement('div');
    div.className = 'tile cosm';
    div.innerHTML =
      '<span class="x" title="Eliminar">&times;</span>' +
      '<span class="avatar" style="background:' + tono(nombre) + '">' + limpio(iniciales(nombre)) + '</span>' +
      '<span class="nombre">' + limpio(nombre) + '</span>' +
      (enCurso
        ? '<span class="pill pill-curso">' + (enCurso > 1 ? enCurso + ' en curso' : 'En curso') + '</span>'
        : '<span class="pill pill-libre">Disponible</span>');

    div.onclick = function(){ abrirHoja(nombre); };
    div.querySelector('.x').onclick = function(e){
      e.stopPropagation();
      if(confirm('Eliminar a ' + nombre + ' de la lista?')){
        DB.cosmiatras = DB.cosmiatras.filter(function(c){ return c !== nombre; });
        guardar();
        pintarCosmiatras();
      }
    };
    cont.insertBefore(div, mas);
  });
}

$('btnAgregar').onclick = function(){
  var n = (prompt('Nombre de la cosmiatra') || '').trim();
  if(!n) return;
  if(DB.cosmiatras.some(function(c){ return c.toLowerCase() === n.toLowerCase(); })){
    return aviso('Ese nombre ya existe');
  }
  DB.cosmiatras.push(n);
  guardar();
  pintarCosmiatras();
};

/* ============================================================
   PANTALLA 2 : hoja del dia
   ------------------------------------------------------------
   "filas" son los renglones del formulario de la paciente actual.
     id === null  -> el procedimiento todavia no arranca
     id           -> identificador de su registro en DB.registros
   ============================================================ */
var filas = [];

function filaVacia(){ return { texto:'', id:null }; }

function abrirHoja(nombre){
  cosmActual = nombre;
  $('fechaHoy').textContent = fechaLarga(hoy());
  nuevaPaciente();
  pantalla(2);
  pintarHoja();
  pintarPendientes();
  $('inPaciente').focus();
}

function nuevaPaciente(){
  filas = [filaVacia(), filaVacia()];
  $('inPaciente').value = '';
  pintarProcs();
}

function hayIniciados(){
  return filas.some(function(f){ return f.id !== null; });
}

function refrescar(){
  guardar();
  pintarProcs();
  pintarHoja();
  pintarPendientes();
}

/* ---------- renglones de procedimiento ---------- */
function pintarProcs(){
  var cont = $('listaProcs');
  cont.innerHTML = '';
  filas.forEach(function(f, i){ cont.appendChild(filaProcDOM(f, i)); });

  /* mientras haya algo iniciado, el nombre de la paciente queda fijo */
  var bloquear = hayIniciados();
  $('inPaciente').disabled = bloquear;
  $('btnNueva').classList.toggle('oculto', !bloquear);
}

function filaProcDOM(f, i){
  var reg = f.id === null ? null : porId(f.id);

  var row = document.createElement('div');
  row.className = 'fila-proc';
  if(reg && !reg.fin) row.classList.add('en-marcha');

  /* campo de texto */
  var campo = document.createElement('div');
  var lab = document.createElement('label');
  lab.textContent = 'Procedimiento ' + (i + 1);
  var inp = document.createElement('input');
  inp.value = f.texto;
  inp.placeholder = 'Tratamiento';
  inp.autocomplete = 'off';
  inp.disabled = !!reg;
  inp.oninput = function(){ f.texto = inp.value; };
  inp.onkeydown = function(e){ if(e.key === 'Enter') iniciarFila(i); };
  campo.appendChild(lab);
  campo.appendChild(inp);

  /* estado / duracion */
  var estado = document.createElement('div');
  estado.className = 'estado';
  if(reg && !reg.fin){
    estado.classList.add('curso');
    estado.textContent = 'En curso desde ' + reg.inicio;
  } else if(reg){
    estado.textContent = reg.inicio + ' a ' + reg.fin + '  ·  ' + minutos(reg.inicio, reg.fin) + ' min';
  }

  /* boton principal: Iniciar -> Terminar -> Listo */
  var btn = document.createElement('button');
  btn.className = 'btn btn-sm';
  if(!reg){
    btn.className += ' btn-rosa';
    btn.innerHTML = '&#9654; Iniciar';
    btn.onclick = function(){ iniciarFila(i); };
  } else if(!reg.fin){
    btn.className += ' btn-verde';
    btn.innerHTML = '&#9632; Terminar';
    btn.onclick = function(){ terminarFila(i); };
  } else {
    btn.className += ' btn-listo';
    btn.textContent = 'Listo';
    btn.disabled = true;
  }

  /* quitar renglon (solo si no arranco y queda mas de uno) */
  var quitar = document.createElement('button');
  quitar.className = 'quitar';
  quitar.innerHTML = '&times;';
  quitar.title = 'Quitar este renglon';
  quitar.onclick = function(){ filas.splice(i, 1); pintarProcs(); };
  if(reg || filas.length <= 1) quitar.classList.add('invisible');

  row.appendChild(campo);
  row.appendChild(estado);
  row.appendChild(btn);
  row.appendChild(quitar);
  return row;
}

function iniciarFila(i){
  var f = filas[i];
  if(f.id !== null) return;

  var pac = $('inPaciente').value.trim();
  if(!pac) return aviso('Escribe el nombre de la paciente');
  var txt = (f.texto || '').trim();
  if(!txt) return aviso('Escribe el procedimiento ' + (i + 1));

  var reg = {
    id: nuevoId(),
    cosmiatra: cosmActual,
    fecha: hoy(),
    paciente: pac,
    procedimiento: txt,
    inicio: ahora(),
    fin: ''
  };
  DB.registros.push(reg);
  f.id = reg.id;
  refrescar();
}

function terminarFila(i){
  var reg = filas[i].id === null ? null : porId(filas[i].id);
  if(!reg) return;
  reg.fin = ahora();
  refrescar();
}

$('btnMasProc').onclick = function(){
  filas.push(filaVacia());
  pintarProcs();
  var libres = $('listaProcs').querySelectorAll('input:not([disabled])');
  if(libres.length) libres[libres.length - 1].focus();
};

$('btnNueva').onclick = function(){
  nuevaPaciente();
  $('inPaciente').focus();
};

$('inPaciente').onkeydown = function(e){
  if(e.key === 'Enter'){
    var libre = $('listaProcs').querySelector('input:not([disabled])');
    if(libre) libre.focus();
  }
};

/* ---------- tabla del dia ----------
   Solo muestra la fecha de hoy: manana la hoja aparece limpia,
   pero los registros viejos siguen guardados para el reporte. */
function pintarHoja(){
  var f = hoy();
  var lista = DB.registros.filter(function(r){
    return r.cosmiatra === cosmActual && r.fecha === f;
  });

  var tb = $('tbHoy');
  tb.innerHTML = '';
  $('vacioHoy').classList.toggle('oculto', lista.length > 0);

  lista.forEach(function(r){
    var tr = document.createElement('tr');
    if(!r.fin) tr.className = 'activa';

    tr.innerHTML =
      '<td class="col-paciente" data-tit="Paciente">' + limpio(r.paciente) + '</td>' +
      '<td data-tit="Procedimiento">' + limpio(r.procedimiento) + '</td>' +
      '<td data-tit="Inicio">' + r.inicio + '</td>' +
      '<td data-tit="T&eacute;rmino">' + (r.fin || '&mdash;') + '</td>' +
      '<td class="acciones"></td>';

    var celda = tr.lastChild;
    if(!r.fin){
      var b = document.createElement('button');
      b.className = 'btn btn-verde btn-sm';
      b.innerHTML = '&#9632; Terminar';
      b.onclick = function(){ r.fin = ahora(); refrescar(); };
      celda.appendChild(b);
    } else {
      celda.setAttribute('data-tit', 'Duración');
      celda.innerHTML = '<span class="duracion">' + minutos(r.inicio, r.fin) + ' min</span>';
    }
    tb.appendChild(tr);
  });
}

/* ---------- pendientes de dias anteriores ----------
   Atenciones que se iniciaron y nunca se cerraron. Como la hoja solo
   muestra el dia de hoy, se rescatan aqui para poder cerrarlas. */
function pintarPendientes(){
  var f = hoy();
  var lista = DB.registros.filter(function(r){
    return r.cosmiatra === cosmActual && !r.fin && r.fecha !== f;
  });

  $('cardPend').classList.toggle('oculto', lista.length === 0);
  var tb = $('tbPend');
  tb.innerHTML = '';

  lista.forEach(function(r){
    var tr = document.createElement('tr');
    tr.innerHTML =
      '<td data-tit="Fecha">' + fechaLarga(r.fecha) + '</td>' +
      '<td class="col-paciente" data-tit="Paciente">' + limpio(r.paciente) + '</td>' +
      '<td data-tit="Procedimiento">' + limpio(r.procedimiento) + '</td>' +
      '<td data-tit="Inicio">' + r.inicio + '</td>' +
      '<td class="acciones"></td>';

    var celda = tr.lastChild;

    var cerrar = document.createElement('button');
    cerrar.className = 'btn btn-verde btn-sm';
    cerrar.textContent = 'Poner hora';
    cerrar.onclick = function(){ cerrarPendiente(r); };
    celda.appendChild(cerrar);

    var borrar = document.createElement('button');
    borrar.className = 'quitar';
    borrar.innerHTML = '&times;';
    borrar.title = 'Eliminar este registro';
    borrar.onclick = function(){
      if(!confirm('Eliminar el registro de ' + r.paciente + ' del ' + fechaLarga(r.fecha) + '?')) return;
      DB.registros = DB.registros.filter(function(x){ return x.id !== r.id; });
      refrescar();
    };
    celda.appendChild(borrar);

    tb.appendChild(tr);
  });
}

function cerrarPendiente(r){
  var h = prompt('Hora de termino de "' + r.procedimiento + '" (HH:MM)', r.inicio);
  if(h === null) return;
  h = h.trim();
  var p = /^([01]?[0-9]|2[0-3]):([0-5][0-9])$/.exec(h);
  if(!p) return aviso('Hora invalida. Usa el formato HH:MM, por ejemplo 15:30');
  var fin = p[1].padStart(2,'0') + ':' + p[2];
  if(minutos(r.inicio, fin) < 0) return aviso('La hora de termino es anterior a la de inicio');
  r.fin = fin;
  refrescar();
}

/* Si la pagina se queda abierta y pasa la medianoche, la hoja se limpia sola. */
var diaVista = hoy();
setInterval(function(){
  if(hoy() === diaVista) return;
  diaVista = hoy();
  if($('p2').classList.contains('oculto')) return;
  nuevaPaciente();
  $('fechaHoy').textContent = fechaLarga(diaVista);
  pintarHoja();
  pintarPendientes();
  aviso('Cambio de dia: la hoja empieza limpia');
}, 30000);

/* ---------- pantalla 3 : reporte ---------- */
function abrirReporte(){
  var sel = $('fCosm'), previo = sel.value;
  sel.innerHTML = '<option value="">Todas</option>';
  DB.cosmiatras.forEach(function(c){
    var o = document.createElement('option');
    o.textContent = c;
    sel.appendChild(o);
  });
  sel.value = DB.cosmiatras.indexOf(previo) >= 0 ? previo : '';
  if(!$('fFecha').value) $('fFecha').value = hoy();
  pantalla(3);
  pintarReporte();
}

function filtrados(){
  var f = $('fFecha').value, c = $('fCosm').value;
  return DB.registros.filter(function(r){
    return (!f || r.fecha === f) && (!c || r.cosmiatra === c);
  });
}

function pintarReporte(){
  var datos = filtrados(), tot = 0, pacientes = {};
  var tb = $('tbRep');
  tb.innerHTML = '';
  $('vacioRep').classList.toggle('oculto', datos.length > 0);

  datos.forEach(function(r){
    var m = minutos(r.inicio, r.fin);
    if(m) tot += m;
    pacientes[r.fecha + '|' + r.cosmiatra + '|' + r.paciente] = 1;

    tb.innerHTML +=
      '<tr>' +
      '<td data-tit="Fecha">' + fechaLarga(r.fecha) + '</td>' +
      '<td data-tit="Cosmiatra">' + limpio(r.cosmiatra) + '</td>' +
      '<td class="col-paciente" data-tit="Paciente">' + limpio(r.paciente) + '</td>' +
      '<td data-tit="Procedimiento">' + limpio(r.procedimiento) + '</td>' +
      '<td data-tit="Inicio">' + r.inicio + '</td>' +
      '<td data-tit="T&eacute;rmino">' + (r.fin || '&mdash;') + '</td>' +
      '<td data-tit="Minutos">' + (m === '' ? '&mdash;' : m) + '</td></tr>';
  });

  $('tPac').textContent = Object.keys(pacientes).length;
  $('tAt').textContent  = datos.length;
  $('tMin').textContent = tot;
}

$('fFecha').onchange = pintarReporte;
$('fCosm').onchange  = pintarReporte;

$('btnExcel').onclick = function(){
  var datos = filtrados();
  if(!datos.length) return aviso('No hay registros para exportar');
  var salto = String.fromCharCode(10);
  var csv = 'Fecha;Cosmiatra;Paciente;Procedimiento;Hora inicio;Hora termino;Minutos' + salto;
  datos.forEach(function(r){
    csv += [fechaLarga(r.fecha), r.cosmiatra, r.paciente, r.procedimiento,
            r.inicio, r.fin, minutos(r.inicio, r.fin)].join(';') + salto;
  });
  var a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([String.fromCharCode(65279) + csv], { type:'text/csv;charset=utf-8' }));
  a.download = 'productividad_' + ($('fFecha').value || 'todo') + '.csv';
  a.click();
};

/* ---------- navegacion ---------- */
$('btnReporte').onclick = abrirReporte;
$('btnVolver').onclick  = function(){ pintarCosmiatras(); pantalla(1); };

pintarCosmiatras();
pantalla(1);
</script>
</body>
</html>
